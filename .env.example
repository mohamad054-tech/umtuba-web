# Copy to .env.local — never commit secrets
# (.env* is gitignored; .env.example is allowed)
#
# Public site origin for metadataBase, canonical URLs, sitemap, and Open Graph.
# Production: https://umtuba.com
# Development: http://localhost:3000 (used automatically when unset)
# Preview deploys: set explicitly, or VERCEL_URL is used as a safe fallback.
# Malformed values are ignored; production then falls back to https://umtuba.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
#
# Required for auth / session / protected routes (browser + server + middleware):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
#
# Optional alias for the same publishable/anon key (not required if PUBLISHABLE_KEY is set):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
#
# Never put SUPABASE_SERVICE_ROLE_KEY in this Next.js app or any NEXT_PUBLIC_* variable.
# Privileged DB work uses SECURITY DEFINER RPCs, not a service-role client in the web app.
#
# Optional local/dev allowlist for /admin/ads (comma-separated auth user UUIDs).
# Production should prefer Auth app_metadata.platform_admin or public.platform_admins.
# UMTUBA_PLATFORM_ADMIN_IDS=
#
# When required Supabase public vars are missing/invalid:
# - Protected routes (/messages, /notifications, /settings, /create, /saved, /rewards, /creator)
#   return HTTP 503 (fail closed) — they are never left open.
# - /login, /signup, /register, /forgot-password, /auth/* also return 503 (avoids broken auth / redirect loops).
# - Other public pages may render without a session; Supabase client calls will fail safely.
#
# Password reset (Supabase Auth → URL Configuration):
# Add your site origin redirect allow-list entries, e.g.:
#   http://localhost:3000/auth/callback
#   https://YOUR_DOMAIN/auth/callback
# Recovery emails use PKCE and land on /auth/callback?next=/auth/update-password
# (tokens are exchanged server-side into cookies — not kept in the URL).

# Live Media V2 — LiveKit Cloud (optional until /live media is used)
# Dashboard: https://cloud.livekit.io → your project → Settings → Keys
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Same WebSocket URL from project overview / Keys page (wss://….livekit.cloud)
LIVEKIT_URL=wss://your-project.livekit.cloud
# Browser-only public URL (must be the wss:// URL — never put API secret here)
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# ---------------------------------------------------------------------------
# Store / Stripe payments (server-only secrets — never commit real values)
# ---------------------------------------------------------------------------
# Mode must match key prefixes (test ↔ sk_test_/pk_test_, live ↔ sk_live_/pk_live_).
# Live mode is fail-closed unless the Production Gate is fully satisfied.
# STRIPE_MODE=test
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# App origin used for Checkout success/cancel URLs (HTTPS required for live):
# NEXT_PUBLIC_APP_URL=http://localhost:3000
#
# Live Production Gate (placeholders only in docs — use real values in host env):
# STRIPE_MODE=live
# STRIPE_LIVE_PAYMENTS_ENABLED=true
# STRIPE_PRODUCTION_GATE_ACK=I_UNDERSTAND_LIVE_STRIPE_CHARGES_REAL_MONEY
# STRIPE_SECRET_KEY=sk_live_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_APP_URL=https://your.production.origin
# Optional: reject test keys when NODE_ENV/VERCEL_ENV is production
# STRIPE_REQUIRE_LIVE_IN_PRODUCTION=true
# Never set STRIPE_ALLOW_LIVE_IN_NON_PRODUCTION except in automated fixtures.

# ---------------------------------------------------------------------------
# Store / Partial-refund provider money — isolated Stripe TEST prep (NAMES only)
# ---------------------------------------------------------------------------
# Default: leave ALL of these unset (gate OFF, execution mode off).
# Do NOT enable until an explicit isolated TEST activation GO.
# Place real TEST values only in local `.env.local` — never commit secrets.
# Required Stripe TEST shape for future dry-run (credentials only — no activation):
# STRIPE_MODE=test
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# Future temporary TEST activation GO only (keep unset now):
# UMTUBA_STORE_PARTIAL_REFUND_PROVIDER_MONEY_ENABLED=true
# UMTUBA_STORE_PARTIAL_REFUND_PROVIDER_MONEY_GATE_ACK=I_UNDERSTAND_PARTIAL_REFUND_PROVIDER_MONEY_MOVES_REAL_FUNDS
# UMTUBA_STORE_PARTIAL_REFUND_PROVIDER_MONEY_ALLOW_IN_NON_PRODUCTION=commerce-partial-refund-provider-money-fixture-v1
# UMTUBA_STORE_PARTIAL_REFUND_PROVIDER_MONEY_EXECUTION_MODE=test
# Must remain ABSENT for TEST validation:
# UMTUBA_STORE_PARTIAL_REFUND_PROVIDER_MONEY_PRODUCTION_EXEC_ACK=

# ---------------------------------------------------------------------------
# Store / Seller live payouts (server-only gate — never commit real secrets)
# ---------------------------------------------------------------------------
# Fail-closed: live seller payouts stay OFF unless the Production Gate is complete.
# V1 provider is Manual Ops Live Clearing only (implementation in later slices).
# SELLER_LIVE_PAYOUTS_ENABLED=false
# SELLER_LIVE_PAYOUT_PRODUCTION_GATE_ACK=I_UNDERSTAND_LIVE_SELLER_PAYOUTS_MOVE_REAL_MONEY
# SELLER_LIVE_PAYOUT_PROVIDER=manual_ops_live
# Never set SELLER_LIVE_PAYOUT_ALLOW_IN_NON_PRODUCTION except in automated fixtures.
# SELLER_LIVE_PAYOUT_ALLOW_IN_NON_PRODUCTION=commerce-seller-live-payout-provider-fixture-v1

# Unfinished surface previews (development only; ignored in production builds):
# Leave unset to show Watch/Live lab chrome in development.
# Set to 0/false to hide Watch demo panels, Live collab mocks, etc. while developing.
# Messenger fake presence dots stay OFF unless this is explicitly 1/true (opt-in).
# NEXT_PUBLIC_ALLOW_SURFACE_PREVIEWS=0
# NEXT_PUBLIC_ALLOW_SURFACE_PREVIEWS=1
