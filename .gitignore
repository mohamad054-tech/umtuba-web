# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local diagnostics / probe artifacts (never commit)
tmp-*
/tmp-*.json
/tmp-*.png
/tmp-*.jpg
/tmp-*.webp

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# store remote E2E local Auth UUID config (never commit real user ids)
scripts/store-e2e/config.local.sql
scripts/store-e2e/_tmp*
scripts/store-e2e/*.local.*

# collaboration E2E local Auth UUID config (never commit real user ids)
scripts/collaboration-e2e/config.local.sql
scripts/collaboration-e2e/_tmp*
scripts/collaboration-e2e/*.local.*

# playwright local artifacts
test-results/
playwright-report/
